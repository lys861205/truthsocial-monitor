# 复制此文件为 .env 并填入你的信息
DASHSCOPE_API_KEY=your_qwen_api_key_here
LLM_MODEL_NAME=qwen-plus # 默认 qwen-plus，可选 qwen-max, qwen-turbo 等

# ----------------- 推送渠道配置 (支持多选，填了哪个就推哪个) -----------------

# 1. 飞书机器人 (推荐)
FEISHU_WEBHOOK=
# (可选) 如果你开启了签名校验，填在这里
FEISHU_SECRET=

# 2. 钉钉机器人
DINGTALK_WEBHOOK=
# (可选) 如果你开启了加签，填在这里
DINGTALK_SECRET=

# 3. 企业微信机器人 (分段发送)
WEBHOOK_URL=

# 4. PushPlus (用于推给普通微信)
PUSHPLUS_TOKEN=
PUSHPLUS_TOPIC=
